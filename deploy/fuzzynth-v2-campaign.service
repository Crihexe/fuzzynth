[Unit]
Description=Fuzzynth focused custom Luna V8 campaign
After=network-online.target docker.service fuzzynth-telegram-control.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/root/fuzzynth
Environment=PYTHONPATH=/root/fuzzynth/src
ExecStart=/usr/bin/python3 -m fuzzynth campaign-run --live --repo-root /root/fuzzynth --state-root /root/fuzzynth/state --seed 20260903 --window-size 8 --worker luna-custom-low-compiler-optdebug-explicit-v3 --worker luna-custom-low-compiler-optdebug-lean-v3 --worker luna-custom-low-wasm-asan-explicit-v3 --worker luna-custom-low-wasm-asan-lean-v3 --worker luna-custom-low-memory-asan-explicit-v3 --worker luna-custom-low-memory-asan-lean-v3 --worker luna-custom-none-language-asan-explicit-v3 --worker luna-custom-none-language-asan-lean-v3 --worker luna-custom-low-security-asan-explicit-v3 --worker luna-custom-low-security-asan-lean-v3 --corpus-index /root/fuzzynth/.local/datasets/v8_js_pocs_preview_v3/javascript_corpus/index.sqlite
Restart=on-failure
RestartSec=10s
TimeoutStopSec=660s
UMask=0077
SyslogIdentifier=fuzzynth-v2-campaign

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/root/fuzzynth/state
InaccessiblePaths=/root/red-sailor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
