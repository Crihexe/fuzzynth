[Unit]
Description=Fuzzynth paired-prompt preview-v3 V8 campaign
After=network-online.target docker.service fuzzynth-telegram-control.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/root/fuzzynth
Environment=PYTHONPATH=/root/fuzzynth/src
ExecStart=/usr/bin/python3 -m fuzzynth campaign-run --live --repo-root /root/fuzzynth --state-root /root/fuzzynth/state --seed 20260902 --window-size 2 --worker spark-custom-iterative-js-rich --worker spark-custom-iterative-js-lean --worker luna-custom-high-iterative-js-rich --worker luna-custom-high-iterative-js-lean --worker luna-custom-low-iterative-js-rich --worker luna-custom-low-iterative-js-lean --worker luna-custom-none-spark-fallback-js-rich --worker luna-custom-none-spark-fallback-js-lean --worker gpt-4o-mini-official-temperature-js-rich --worker gpt-4o-mini-official-temperature-js-lean --worker gpt-4.1-nano-official-temperature-js-rich --worker gpt-4.1-nano-official-temperature-js-lean --corpus-index /root/fuzzynth/.local/datasets/v8_js_pocs_preview_v3/javascript_corpus/index.sqlite
Restart=on-failure
RestartSec=10s
TimeoutStopSec=660s
UMask=0077
SyslogIdentifier=fuzzynth-v2-campaign

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/root/fuzzynth/state
InaccessiblePaths=/root/red-sailor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
